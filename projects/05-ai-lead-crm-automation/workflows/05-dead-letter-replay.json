      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH updated AS (\n    UPDATE lead_crm.outbox_jobs\n    SET status = 'PENDING', attempt_count = 0, available_at = NOW(),\n        locked_at = NULL, last_error = NULL, updated_at = NOW()\n    WHERE id = $1::uuid AND status = 'DEAD_LETTER'\n    RETURNING *\n), audit AS (\n    INSERT INTO lead_crm.audit_events (\n        correlation_id, submission_id, event_type, actor_type, event_data\n    )\n    SELECT lead.correlation_id, lead.id, 'OUTBOX_JOB_REPLAYED', 'HUMAN',\n           jsonb_build_object('job_id', updated.id, 'job_type', updated.job_type)\n    FROM updated JOIN lead_crm.lead_submissions lead ON lead.id = updated.submission_id\n    RETURNING id\n)\nSELECT 'REPLAY_QUEUED' AS outcome, updated.*, audit.id AS audit_event_id\nFROM updated LEFT JOIN audit ON true;",
          "options": {
            "queryReplacement": "={{ [ $json.outbox_job_id ] }}"
          }
        },
