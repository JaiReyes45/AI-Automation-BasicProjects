      {
        "parameters": {
          "operation": "executeQuery",
          "query": "UPDATE lead_crm.lead_submissions\nSET\n  processing_status = 'CRM_SYNCED',\n  crm_provider = 'hubspot',\n  crm_contact_id = $2,\n  crm_company_id = $3,\n  crm_deal_id = $4,\n  crm_synced_at = NOW(),\n  crm_sync_error = NULL,\n  updated_at = NOW()\nWHERE id = $1::uuid\nRETURNING\n  id AS submission_record_id,\n  submission_id,\n  processing_status,\n  crm_provider,\n  crm_contact_id,\n  crm_company_id,\n  crm_deal_id,\n  crm_synced_at;",
          "options": {
            "queryReplacement": "={{ [\n  $('Build HubSpot Payloads').first().json.submission_record_id,\n  $('HubSpot Contact Upsert').first().json.results[0].id,\n  (Number($('Search HubSpot Company').first().json.total || 0) > 0\n  ? $('Search HubSpot Company').first().json.results[0].id\n  : $('Create HubSpot Company').first().json.id),\n  $('Build HubSpot Payloads').first().json.qualification === 'HOT'\n    ? (\n        Number($('Search Existing HubSpot Deal').first().json.total || 0) > 0\n          ? $('Search Existing HubSpot Deal').first().json.results[0].id\n          : $('HubSpot Deal Create').first().json.id\n      )\n    : null\n] }}"
          }
