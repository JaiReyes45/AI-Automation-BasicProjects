        ],
        "id": "e273ffa8-5f8c-44c9-b375-cfb30f206b03",
        "name": "Persist CRM Sync Success"
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const source = $('Build HubSpot Payloads').first().json;\n\nconst rawError =\n  $json.error ||\n  $json.cause ||\n  $json;\n\nconst message = String(\n  rawError.message ||\n  $json.message ||\n  'HubSpot CRM synchronization failed'\n).slice(0, 1000);\n\nconst statusCode =\n  Number(\n    rawError.status ||\n    rawError.response?.status ||\n    rawError.statusCode ||\n    rawError.httpCode ||\n    $json.status ||\n    $json.statusCode ||\n    $json.httpCode ||\n    0\n  ) || null;\n\nconst category =\n  rawError.category ||\n  rawError.code ||\n  $json.category ||\n  $json.code ||\n  null;\n\nconst failedNode =\n  rawError.node?.name ||\n  $json.node?.name ||\n  'HubSpot CRM request';\n\nreturn {\n  json: {\n    submission_record_id: source.submission_record_id,\n    submission_id: source.submission_id,\n    correlation_id: source.correlation_id,\n    processing_status: 'SYNC_FAILED',\n    crm_provider: 'hubspot',\n    failed_node: failedNode,\n    crm_sync_error: {\n      message,\n      status_code: statusCode,\n      category,\n      occurred_at: new Date().toISOString()\n    },\n    should_continue: false\n  }\n};"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          592,
          368
        ],
        "id": "b1d372b0-dcd7-4b96-9fd6-f82667edd444",
