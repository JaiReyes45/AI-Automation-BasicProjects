        "id": "583cc990-3572-5eee-bc8a-72dc0e39d549",
        "name": "Fetch CRM-Ready Lead"
      },
      {
        "parameters": {
          "jsCode": "const row = $input.first().json;\nconst payload = typeof row.normalized_payload === 'string' ? JSON.parse(row.normalized_payload) : (row.normalized_payload || {});\nconst aiExtraction = typeof row.ai_extraction === 'string' ? JSON.parse(row.ai_extraction) : (row.ai_extraction || {});\n\nconst email = String(row.email_normalized || payload.email || '').trim().toLowerCase();\nconst website = String(payload.website || '').trim();\nconst companyName = String(payload.company_name || 'Unknown Company').trim();\nconst qualification = String(row.qualification || 'WARM').trim().toUpperCase();\nconst needSummary = String(aiExtraction.need_summary || payload.message || 'CRM opportunity').trim();\n\nlet companyDomain = website.trim();\nif (companyDomain.toLowerCase().startsWith('https://')) companyDomain = companyDomain.slice(8);\nelse if (companyDomain.toLowerCase().startsWith('http://')) companyDomain = companyDomain.slice(7);\nif (companyDomain.toLowerCase().startsWith('www.')) companyDomain = companyDomain.slice(4);\ncompanyDomain = companyDomain.split('/')[0].split('?')[0].split('#')[0].split(':')[0].trim();\nif (!companyDomain) companyDomain = String(row.submission_id) + '.synthetic.invalid';\n\nconst leadStatusByQualification = { HOT: 'IN_PROGRESS', WARM: 'OPEN', COLD: 'NEW' };\n\nreturn [{\n  json: {\n    ...row,\n    ai_extraction: aiExtraction,\n    hubspot_contact: {\n      idProperty: 'email',\n      id: email,\n      properties: {\n        email,\n        firstname: String(payload.first_name || '').trim(),\n        lastname: String(payload.last_name || '').trim(),\n        phone: String(payload.phone || '').trim(),\n        jobtitle: String(payload.job_title || '').trim(),\n        company: companyName,\n        hs_lead_status: leadStatusByQualification[qualification] || 'NEW',\n        hubspot_owner_id: '100128796'\n      }\n    },\n    hubspot_company: {\n      properties: {\n        name: companyName,\n        domain: companyDomain,\n        website: website || undefined\n      }\n    },\n    hubspot_deal: qualification === 'HOT' ? {\n    properties: {\n    dealname: (companyName + ' - ' + needSummary).slice(0, 150),\n    amount: String(payload.budget_amount ?? ''),\n    dealstage: 'appointmentscheduled',\n    pipeline: 'default',\n    hubspot_owner_id: '100128796',\n    p05_submission_id: String(row.submission_id)\n    }\n  } : null,\n    qualification\n  }\n}];"
        },
        "type": "n8n-nodes-base.code",
