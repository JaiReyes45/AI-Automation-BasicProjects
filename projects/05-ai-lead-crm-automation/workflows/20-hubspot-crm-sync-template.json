        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT\n  id AS submission_record_id,\n  submission_id,\n  correlation_id,\n  email_normalized,\n  normalized_payload,\n  ai_extraction,\n  lead_score,\n  qualification,\n  processing_status\nFROM lead_crm.lead_submissions\nWHERE submission_id = $1::uuid\n  AND processing_status = 'CRM_SYNC_PENDING';",
