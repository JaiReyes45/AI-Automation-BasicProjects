      "parameters": {
        "jsCode": "if (($json.outbox.failed||0)+($json.outbox.dead||0)>0) throw new Error('Recovery failed'); return [{json:{result:'PASS',duplicate_verified:true,interview_verified:true,recovery_verified:true,gmail_connected:false,status:$json}}];"
      }
