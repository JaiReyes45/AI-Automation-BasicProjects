        "nodeCredentialType": "gmailOAuth2"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GAol03INdoc1aOgm",
          "name": "Gmail account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
