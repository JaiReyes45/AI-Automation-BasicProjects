{
  "id": "project07Intake",
  "name": "Project 07 \u00b7 01 Synthetic email intake",
  "active": false,
  "nodes": [
    {
      "id": "execute-manually",
      "name": "Execute manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "synthetic-email",
      "name": "Synthetic email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "const run = Date.now().toString();\nreturn [{json:{account:'demo@example.test', id:'demo-'+run, thread_id:'thread-'+run,\nreceived_at:new Date().toISOString(),\nbody:'Company: Example Labs\\nRole: QA Engineer Intern\\nReference: APP-'+run+'\\nWe have received your application.'}}];"
      }
    },
    {
      "id": "classify-match-and-save",
      "name": "Classify match and save",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://engine:8765/ingest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "project07EngineHeader",
          "name": "Project 07 local engine"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "review-result",
      "name": "Review result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().map(i=>({json:{...i.json,next_step:['create','update'].includes(i.json.action)?'Run label delivery':'Inspect review reason before changing an application'}}));"
      }
    },
    {
      "id": "inspect-failure-and-retry",
      "name": "Inspect failure and retry",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        600,
        560
      ],
      "parameters": {
        "errorMessage": "Workflow stopped. Inspect the failed HTTP node. Fix its input or service health, then retry; message IDs prevent duplicate records."
      }
    },
    {
      "id": "read-before-running",
      "name": "Read before running",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "content": "## Project 07 \u2014 synthetic mailbox only\nNo Gmail access. HTTP steps call a private Docker service. Application state and label jobs are durable. Workflows stay inactive; use Execute workflow. Live OAuth and Gmail labels are D3.2.",
        "height": 180,
        "width": 650
      }
    }
  ],
  "connections": {
    "Execute manually": {
      "main": [
        [
          {
            "node": "Synthetic email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Synthetic email": {
      "main": [
        [
          {
            "node": "Classify match and save",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify match and save": {
      "main": [
        [
          {
            "node": "Review result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Inspect failure and retry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "pinData": {}
}
