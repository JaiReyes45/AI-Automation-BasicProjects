    },
    {
      "id": "Read calendar events",
      "name": "Read calendar events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "=https://www.googleapis.com/calendar/v3/calendars/primary/events?singleEvents=true&orderBy=startTime&maxResults=100&timeMin={{ new Date(Date.now()-30*86400000).toISOString() }}&timeMax={{ new Date(Date.now()+180*86400000).toISOString() }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "options": {
          "timeout": 25000,
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "pageToken",
                    "value": "={{ $response.body.nextPageToken || \"\" }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.nextPageToken }}",
              "limitPagesFetched": true,
              "maxRequests": 20
            }
          }
        }
      },
      "position": [
        460,
        300
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "rkf0GTF07ovWV6Ko",
          "name": "CareerFlow Calendar"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "id": "Calendar snapshot",
      "name": "Calendar snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const pages=$input.all();if(pages.at(-1).json.nextPageToken)throw new Error('Calendar exceeds 2000 events. Narrow the window.');return [{json:{calendar_name:$('Primary calendar').first().json.summary,window_start:new Date(Date.now()-30*86400000).toISOString(),window_end:new Date(Date.now()+180*86400000).toISOString(),items:pages.flatMap(p=>p.json.items||[])}}];",
        "mode": "runOnceForAllItems"
      },
      "position": [
        690,
        300
      ]
    },
    {
      "id": "Save calendar snapshot",
      "name": "Save calendar snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "http://crm:8780/internal/calendar/import",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 25000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "position": [
        920,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "project07EngineHeader",
          "name": "Project 07 local engine"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "id": "Claim confirmed meetings",
      "name": "Claim confirmed meetings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "http://crm:8780/internal/actions/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 25000
        },
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({kind:\"meeting\"}) }}"
      },
      "position": [
        1150,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "project07EngineHeader",
          "name": "Project 07 local engine"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "id": "Meeting jobs",
      "name": "Meeting jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return ($json.jobs||[]).map(json=>({json}));",
        "mode": "runOnceForAllItems"
      },
      "position": [
        1380,
        300
      ]
    },
    {
      "id": "Read existing event",
      "name": "Read existing event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ \"https://www.googleapis.com/calendar/v3/calendars/primary/events/\"+encodeURIComponent($json.event_id) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "options": {
          "timeout": 25000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [
        1610,
        300
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "rkf0GTF07ovWV6Ko",
          "name": "CareerFlow Calendar"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "onError": "continueRegularOutput"
    },
    {
      "id": "Prepare calendar write",
      "name": "Prepare calendar write",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const p=$('Meeting jobs').item.json;const b=$json.body||{};const s=$json.statusCode||0;\nconst base={...p,should_write:false,ok:false,error:'Calendar could not safely prepare this event.'};\nif(p.status==='cancelled'&&(s===404||s===410))return {json:{...base,ok:true}};\nif(s!==200&&s!==404)return {json:base};\nif(s===200&&(b.extendedProperties?.private?.careerflow_event!==p.event_id||Number(b.extendedProperties?.private?.careerflow_revision||1)>Number(p.event_version||1)))return {json:{...base,error:'Calendar ownership or revision changed; review the event.'}};\nif(s===200&&p.private_hold&&(b.attendees||[]).length)return {json:{...base,error:'Guests were added to this reminder; automatic changes are paused.'}};\nif(s===200&&!b.etag)return {json:base};\nconst payload={summary:p.title,description:p.description||'',location:p.location||'',status:p.status||'confirmed',start:{dateTime:p.start,timeZone:'Asia/Manila'},end:{dateTime:p.end,timeZone:'Asia/Manila'},extendedProperties:{private:{...(b.extendedProperties?.private||{}),careerflow_event:p.event_id,careerflow_revision:String(p.event_version||1)}}};\nif(s===404)payload.id=p.event_id;\nif(!p.private_hold)payload.attendees=(p.attendees||[]).map(email=>({email}));\nreturn {json:{...base,should_write:true,method:s===404?'POST':'PATCH',etag:b.etag||'*',payload,send_updates:!p.private_hold&&(p.attendees||[]).length?'all':'none'}};",
        "mode": "runOnceForEachItem"
      },
      "position": [
        1840,
        300
      ]
    },
    {
      "id": "Safe to write",
      "name": "Safe to write",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "safe",
              "leftValue": "={{ $json.should_write }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        2070,
        300
      ]
    },
    {
      "id": "Write calendar event",
      "name": "Write calendar event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ \"https://www.googleapis.com/calendar/v3/calendars/primary/events\"+($json.method===\"PATCH\"?\"/\"+encodeURIComponent($json.event_id):\"\")+\"?sendUpdates=\"+$json.send_updates }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "options": {
          "timeout": 25000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "method": "={{ $json.method }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify($json.method===\"PATCH\"?{\"If-Match\":$json.etag}:{}) }}"
      },
      "position": [
        2300,
        300
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "rkf0GTF07ovWV6Ko",
          "name": "CareerFlow Calendar"
        }
