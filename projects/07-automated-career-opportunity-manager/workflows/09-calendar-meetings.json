      "onError": "continueRegularOutput"
    },
    {
      "id": "Read back event",
      "name": "Read back event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "={{ \"https://www.googleapis.com/calendar/v3/calendars/primary/events/\"+encodeURIComponent($(\"Meeting jobs\").item.json.event_id) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "options": {
          "timeout": 25000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [
        2530,
        300
      ],
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "rkf0GTF07ovWV6Ko",
          "name": "CareerFlow Calendar"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500,
      "onError": "continueRegularOutput"
    },
    {
      "id": "Meeting outcome",
      "name": "Meeting outcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const p=$('Meeting jobs').item.json;const b=$json.body||{};const cancelled=p.status==='cancelled';const ok=$json.statusCode===200&&b.id===p.event_id&&b.extendedProperties?.private?.careerflow_event===p.event_id&&Number(b.extendedProperties?.private?.careerflow_revision||1)===Number(p.event_version||1)&&b.status===(p.status||'confirmed')&&(!p.private_hold||!(b.attendees||[]).length)&&(cancelled||(Date.parse(b.start?.dateTime)===Date.parse(p.start)&&Date.parse(b.end?.dateTime)===Date.parse(p.end)));return {json:{id:p.id,lease:p.lease,ok,external_id:b.id,error:'Calendar readback did not confirm the event. Status '+($json.statusCode||0)}};",
        "mode": "runOnceForEachItem"
      },
      "position": [
        2760,
        300
      ]
    },
    {
      "id": "Record meeting outcome",
      "name": "Record meeting outcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "url": "http://crm:8780/internal/actions/result",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
