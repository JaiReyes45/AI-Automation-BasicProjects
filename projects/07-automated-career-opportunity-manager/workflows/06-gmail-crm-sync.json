      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "jsCode": "const run=$('Start mailbox page').first().json;const page=$json.body;\nconst messages=page.messages||[];\nif(!Array.isArray(messages)||messages.length>run.max_results||messages.some(m=>!m.id))throw new Error('Invalid Gmail page');\nreturn [{json:{account:run.account,run_id:run.run_id,lease_token:run.lease_token,page_index:run.page_index,\npage_token:run.page_token,next_page_token:page.nextPageToken||null,message_ids:[...new Set(messages.map(m=>m.id))],messages}}];",
        "mode": "runOnceForAllItems"
      }
