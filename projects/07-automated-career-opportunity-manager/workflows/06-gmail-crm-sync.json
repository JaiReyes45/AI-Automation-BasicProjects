      ],
      "parameters": {
        "jsCode": "const items=$input.all();const failed=items.find(i=>i.json.statusCode!==200||!i.json.body?.id||!i.json.body?.payload);\nif(failed)return [{json:{failed:true,error:[401,403].includes(failed.json.statusCode)?'authorization':'provider_error'}}];\nreturn items.map((item,index)=>({json:item.json.body,pairedItem:{item:index}}));",
