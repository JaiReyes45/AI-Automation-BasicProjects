    {
      "id": "Recent career messages",
      "name": "Recent career messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages?maxResults=10&q=newer_than%3A7d%20%7Bsubject%3Aapplication%20subject%3Ainterview%20subject%3Ainternship%20subject%3Aassessment%20subject%3A%22thank%20you%20for%20applying%22%20subject%3Ashortlisted%20subject%3A%22job%20offer%22%20subject%3A%22additional%20information%22%7D%20-category%3Apromotions%20-in%3Asent%20-in%3Adrafts%20-from%3Ajobalert.indeed.com%20-subject%3A%22job%20alert%22%20-subject%3A%22jobs%20you%20may%22",
        "options": {
          "timeout": 20000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 750
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "pageToken",
                    "value": "={{ $response.body.nextPageToken || \"\" }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.nextPageToken }}",
              "limitPagesFetched": true,
              "maxRequests": 20,
              "requestInterval": 750
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GAol03INdoc1aOgm",
          "name": "Gmail account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "id": "Collect pages",
      "name": "Collect pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "jsCode": "const pages=$input.all();if(pages.at(-1).json.nextPageToken)throw new Error('Seven-day search exceeded 200 messages; narrow query before retry.');\nconst ids=new Map();for(const p of pages)for(const m of p.json.messages||[])ids.set(m.id,m);\nreturn [{json:{account:$('Gmail account').first().json.emailAddress,messages:[...ids.values()]}}];",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "Select unprocessed",
      "name": "Select unprocessed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "url": "http://crm:8780/internal/select-messages",
        "options": {
          "timeout": 20000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "project07EngineHeader",
          "name": "Project 07 local engine"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "id": "Has messages",
      "name": "Has messages",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.messages.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "Message IDs",
      "name": "Message IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "jsCode": "return $json.messages.map(m=>({json:m}));",
        "mode": "runOnceForAllItems"
      }
    },
    {
      "id": "Read message",
      "name": "Read message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "url": "={{ \"https://gmail.googleapis.com/gmail/v1/users/me/messages/\"+encodeURIComponent($json.id)+\"?format=full\" }}",
        "options": {
          "timeout": 20000,
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 750
            }
          }
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2"
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "GAol03INdoc1aOgm",
          "name": "Gmail account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "id": "Normalize email",
      "name": "Normalize email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "jsCode": "const m=$json;let parts=[];\nfunction visit(p,type){if(p.mimeType===type&&p.body?.data)parts.push(Buffer.from(p.body.data,'base64url').toString('utf8'));for(const child of p.parts||[])visit(child,type);}\nvisit(m.payload,'text/plain');const plain=parts.join('\\n');parts=[];visit(m.payload,'text/html');\nconst html=parts.join('\\n').replace(/<!--[\\s\\S]*?-->/g,' ').replace(/<(script|style)\\b[^>]*>[\\s\\S]*?<\\/\\1>/gi,' ').replace(/<[^>]*>/g,' ');\nconst named={nbsp:' ',zwnj:'',zwj:'',amp:'&',lt:'<',gt:'>',quot:'\"',apos:\"'\",bull:' '};\nconst htmlText=html.replace(/&(#x[0-9a-f]+|#\\d+|[a-z]+);/gi,(all,key)=>{if(key[0]==='#'){const n=parseInt(key.slice(key[1]?.toLowerCase()==='x'?2:1),key[1]?.toLowerCase()==='x'?16:10);return n>0&&n<=0x10ffff?String.fromCodePoint(n):' ';}return named[key.toLowerCase()]??all;}).replace(/\\s+/g,' ').trim();\nconst headers=m.payload.headers||[];const header=n=>headers.find(h=>h.name.toLowerCase()===n)?.value||'';\nreturn {json:{account:$('Gmail account').first().json.emailAddress,id:m.id,thread_id:m.threadId,\nreceived_at:new Date(Number(m.internalDate)).toISOString(),body:(plain||htmlText||'[No text body]').slice(0,45000),html_text:htmlText.slice(0,20000),\nsubject:header('subject'),sender:header('from')}};",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "Oldest first",
      "name": "Oldest first",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        300
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item,index)=>({json:item.json,pairedItem:{item:index}})).sort((a,b)=>a.json.received_at.localeCompare(b.json.received_at));",
        "mode": "runOnceForAllItems"
      }
    },
