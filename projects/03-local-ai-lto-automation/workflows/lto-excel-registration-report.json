    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nlet totalMvuc = 0;\nlet totalLegal = 0;\nlet totalPenalty = 0;\nlet totalAmount = 0;\nlet totalFreelancer = 0;\n\nfor (const item of rows) {\n  totalMvuc += Number(item.json[\"MVUC\"] || 0);\n  totalLegal += Number(item.json[\"Legal Research Fee\"] || 0);\n  totalPenalty += Number(item.json[\"Penalty\"] || 0);\n  totalAmount += Number(item.json[\"Amount Paid\"] || 0);\n  totalFreelancer += Number(item.json[\"Freelancer Fee\"] || 0);\n}\n\nconst overallTotal =\n  totalMvuc +\n  totalLegal +\n  totalPenalty +\n  totalAmount +\n  totalFreelancer;\n\nconst totalRow = {\n  json: {\n    \"Plate Number\": \"TOTAL\",\n    \"Vehicle Type\": \"\",\n    \"MVUC\": totalMvuc,\n    \"Legal Research Fee\": totalLegal,\n    \"Penalty\": totalPenalty,\n    \"Amount Paid\": totalAmount,\n    \"Freelancer Fee\": totalFreelancer,\n    \"Overall Total\": \"\",\n    \"Status\": \"\"\n  }\n};\n\nconst grandTotalRow = {\n  json: {\n    \"Plate Number\": \"GRAND TOTAL\",\n    \"Vehicle Type\": \"\",\n    \"MVUC\": \"\",\n    \"Legal Research Fee\": \"\",\n    \"Penalty\": \"\",\n    \"Amount Paid\": \"\",\n    \"Freelancer Fee\": \"\",\n    \"Overall Total\": overallTotal,\n    \"Status\": \"\"\n  }\n};\n\nreturn [...rows, totalRow, grandTotalRow];"
      },
      "type": "n8n-nodes-base.code",
