    {
      "parameters": {
        "resource": "image",
        "modelId": {
          "__rl": true,
          "value": "qwen2.5vl:7b",
          "mode": "list",
          "cachedResultName": "qwen2.5vl:7b"
        },
        "text": "You are extracting structured information from a scanned Philippine LTO vehicle registration document.\n\nAnalyze the provided image and extract ONLY the following fields:\n\n1. plate_number\n2. vehicle_type\n3. mvuc\n4. legal_research_fee\n5. penalty\n\nRules:\n\n- Read values only from the provided document.\n- Never guess or invent unreadable information.\n- If plate_number cannot be confidently read, return null.\n- If vehicle_type cannot be confidently read, return null.\n- If MVUC cannot be confidently identified, return null.\n- If Legal Research Fee cannot be confidently identified, return null.\n- If there is no penalty shown on the document, return 0.\n- Monetary values must be numbers only.\n- Do not include peso signs or commas in numeric values.\n- Do NOT calculate the total amount paid.\n- Do NOT calculate the freelancer fee.\n- Do NOT extract OR number.\n- Do NOT extract registration date.\n- Do NOT extract any other fields.\n- Do not provide explanations.\n\nReturn ONLY valid JSON using exactly this structure:\n\n{\n  \"plate_number\": null,\n  \"vehicle_type\": null,\n  \"mvuc\": null,\n  \"legal_research_fee\": null,\n  \"penalty\": 0\n}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        560,
        272
      ],
      "id": "1363d6bc-3002-47d0-a6e4-dca4c37fafb9",
      "name": "Analyze image",
      "credentials": {
        "ollamaApi": {
          "id": "uXQMChPjvWnWTcK0",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
