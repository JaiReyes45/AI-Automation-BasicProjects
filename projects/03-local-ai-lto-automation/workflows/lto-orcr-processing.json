      ],
      "id": "b28681da-e1c3-452b-b091-8595b19ba29d",
      "name": "Restore ORCR Image"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst errors = [];\n\n// Plate number\nif (\n  data.plate_number === null ||\n  data.plate_number === undefined ||\n  String(data.plate_number).trim() === ''\n) {\n  errors.push('PLATE_NUMBER_MISSING');\n}\n\n// Vehicle type\nif (\n  data.vehicle_type === null ||\n  data.vehicle_type === undefined ||\n  String(data.vehicle_type).trim() === ''\n) {\n  errors.push('VEHICLE_TYPE_MISSING');\n}\n\n// MVUC\nif (\n  data.mvuc === null ||\n  data.mvuc === undefined ||\n  !Number.isFinite(Number(data.mvuc)) ||\n  Number(data.mvuc) < 0\n) {\n  errors.push('INVALID_MVUC');\n}\n\n// Legal Research Fee\nif (\n  data.legal_research_fee === null ||\n  data.legal_research_fee === undefined ||\n  !Number.isFinite(Number(data.legal_research_fee)) ||\n  Number(data.legal_research_fee) < 0\n) {\n  errors.push('INVALID_LEGAL_RESEARCH_FEE');\n}\n\n// Penalty\nif (\n  data.penalty === null ||\n  data.penalty === undefined ||\n  !Number.isFinite(Number(data.penalty)) ||\n  Number(data.penalty) < 0\n) {\n  errors.push('INVALID_PENALTY');\n}\n\nreturn {\n  json: {\n    ...data,\n    validation_passed: errors.length === 0,\n    validation_errors: errors\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        272
      ],
      "id": "7d8733f6-bbb6-419b-8cca-408f772164d8",
      "name": "Validate ORCR Data"
    },
    {
      "parameters": {
        "jsCode": "const content = $json.content;\n\n// Remove Markdown code fences\nconst cleaned = content\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\n// Convert JSON string into a real JavaScript object\nconst extracted = JSON.parse(cleaned);\n\n// Return clean structured data\nreturn {\n  json: {\n    plate_number: extracted.plate_number ?? null,\n    vehicle_type: extracted.vehicle_type ?? null,\n\n    mvuc:\n      extracted.mvuc !== null &&\n      extracted.mvuc !== undefined\n        ? Number(extracted.mvuc)\n        : null,\n\n    legal_research_fee:\n      extracted.legal_research_fee !== null &&\n      extracted.legal_research_fee !== undefined\n        ? Number(extracted.legal_research_fee)\n        : null,\n\n    penalty:\n      extracted.penalty !== null &&\n      extracted.penalty !== undefined\n        ? Number(extracted.penalty)\n        : 0\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        784,
        272
      ],
