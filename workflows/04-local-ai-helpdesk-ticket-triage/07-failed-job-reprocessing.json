    },
    {
      "parameters": { "source": "database", "workflowId": "helpdesk-routing-sla-v1", "options": { "waitForSubWorkflow": true } },
      "id": "a70194a6-645d-485a-a3eb-264f1073caa1",
      "name": "Replay Routing and SLA",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1420, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE helpdesk.failed_jobs SET resolved_at=now(),terminal=true WHERE failed_job_id=$1::uuid AND resolved_at IS NULL RETURNING failed_job_id;",
        "options": { "queryReplacement": "={{ [$('Claim Failed Job Atomically').first().json.failed_job_id] }}" }
      },
      "credentials": { "postgres": "Helpdesk PostgreSQL (helpdesk_app)" },
      "id": "39fb07a6-3c1d-4cf0-a4d9-78bf429dfd44",
