      "name": "Reset Notification for Retry",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [940, -140]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst failedJobId = String(body.failedJobId || '').trim();\nconst uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nif (!uuid.test(failedJobId)) throw new Error('invalid_failed_job_id');\nreturn [{json:{failedJobId}}];"
      },
      "id": "0518e66a-4f67-4455-bd03-83fb6c0424aa",
      "name": "Validate Reprocess Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE helpdesk.failed_jobs SET attempt_count=attempt_count+1,next_retry_at=NULL,terminal=(attempt_count+1>=3) WHERE failed_job_id=$1::uuid AND terminal=false AND resolved_at IS NULL AND attempt_count<3 AND replay_context->>'version'='1' AND replay_context->>'idempotency_key' ~ '^[a-f0-9]{64}$' RETURNING failed_job_id,ticket_id,stage,idempotency_key,attempt_count,terminal;",
        "options": { "queryReplacement": "={{ [$json.failedJobId] }}" }
      },
      "credentials": { "postgres": "Helpdesk PostgreSQL (helpdesk_app)" },
      "id": "dec8f68c-eb95-4d51-9fc4-6deec9054fa6",
      "name": "Claim Failed Job Atomically",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [460, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ticket_id,correlation_id,idempotency_key,requester_email,subject,description,created_at FROM helpdesk.tickets WHERE idempotency_key=$1 AND ticket_id=$2::uuid;",
        "options": { "queryReplacement": "={{ [$json.idempotency_key,$json.ticket_id] }}" }
      },
      "credentials": { "postgres": "Helpdesk PostgreSQL (helpdesk_app)" },
      "id": "e67ae864-6f77-4294-9ea1-0620496a933d",
      "name": "Load Durable Ticket",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [940, 100]
    },
    {
      "parameters": {
        "jsCode": "const ticket = $json;\nconst job = $('Claim Failed Job Atomically').first().json;\nif (!ticket.ticket_id || !ticket.correlation_id || !ticket.idempotency_key) throw new Error('replay_ticket_not_found');\nreturn [{json:{ticket:{email:ticket.requester_email,subject:ticket.subject,description:ticket.description},correlationId:ticket.correlation_id,idempotencyKey:ticket.idempotency_key,receivedAt:ticket.created_at,failedJobId:job.failed_job_id}}];"
      },
      "id": "211d9c17-a880-4b33-b52b-09997da48710",
      "name": "Build Replay Classification Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
