      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE helpdesk.notification_outbox SET status='pending',attempts=0,last_error_code=NULL WHERE idempotency_key=$1 AND ticket_id=$2::uuid AND status='failed' RETURNING outbox_id;",
        "options": { "queryReplacement": "={{ [$json.idempotency_key,$json.ticket_id] }}" }
      },
      "credentials": { "postgres": "Helpdesk PostgreSQL (helpdesk_app)" },
