    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO helpdesk.tickets (correlation_id,idempotency_key,requester_email,subject,description,status) VALUES ($1::uuid,$2,$3,$4,$5,'received') ON CONFLICT (idempotency_key) DO UPDATE SET updated_at=now() RETURNING ticket_id,correlation_id,(xmax=0) AS inserted;",
        "options": {
          "queryReplacement": "={{ [$json.correlationId,$json.idempotencyKey,$json.ticket.email,$json.ticket.subject,$json.ticket.description] }}"
        }
      },
      "credentials": {
        "postgres": "Helpdesk PostgreSQL (helpdesk_app)"
      },
      "id": "a40d5fdc-fd92-4b26-8100-8c1a099ccad9",
      "name": "Persist Accepted Ticket",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
