    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst body = $json.body || {};\nconst email = String(body.email || '').trim().toLowerCase();\nconst subject = String(body.subject || '').trim();\nconst description = String(body.description || '').trim();\nconst correlationId = crypto.randomUUID();\nconst validEmail = /^\\S+@\\S+\\.\\S+$/.test(email);\nconst error = !validEmail ? 'invalid_email' : !subject ? 'empty_subject' : !description ? 'empty_description' : subject.length > 200 || description.length > 10000 ? 'content_too_long' : null;\nif (error) return [{ json: { accepted: false, statusCode: 400, error, correlationId } }];\nconst providedKey = String($json.headers?.['idempotency-key'] || '');\nconst idempotencyKey = crypto.createHash('sha256').update([email, subject, description, providedKey].join('|')).digest('hex');\nreturn [{ json: { accepted: true, statusCode: 202, correlationId, idempotencyKey, receivedAt: new Date().toISOString(), ticket: { email, subject, description } } }];"
      },
      "id": "e51f1f07-6c02-44ef-9ece-2d881bc8d5bb",
      "name": "Validate and Normalize",
      "type": "n8n-nodes-base.code",
