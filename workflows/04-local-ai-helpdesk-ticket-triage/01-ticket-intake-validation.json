        "operation": "executeQuery",
        "query": "INSERT INTO helpdesk.ticket_events (ticket_id,event_type,actor,correlation_id,metadata) VALUES ($1::uuid,'ticket_accepted','workflow:helpdesk-intake',$2::uuid,$3::jsonb) RETURNING event_id;",
        "options": {
          "queryReplacement": "={{ [$json.ticket_id,$json.correlation_id,JSON.stringify({idempotent_insert:$json.inserted})] }}"
        }
      },
      "credentials": {
