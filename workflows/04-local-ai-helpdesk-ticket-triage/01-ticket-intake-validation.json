        "jsCode": "const intake = $('Validate and Normalize').first().json;\nif (!intake.accepted) throw new Error('unexpected_unaccepted_ticket');\nreturn [{json:{ticket:intake.ticket,correlationId:intake.correlationId,idempotencyKey:intake.idempotencyKey,receivedAt:intake.receivedAt}}];"
      },
